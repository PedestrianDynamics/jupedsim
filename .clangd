# SPDX-License-Identifier: LGPL-3.0-or-later
# clangd has its own include cleaner and does not run misc-include-cleaner from .clang-tidy, so
# it is enabled here as well. Keep IgnoreHeader in step with misc-include-cleaner.IgnoreHeaders.
Diagnostics:
    UnusedIncludes: Strict
    MissingIncludes: Strict
    Includes:
        IgnoreHeader:
            - third-party/.*
