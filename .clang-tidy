---
# Naming convention and the few modernize checks that are clean. This file is the only
# place that decides what clang-tidy checks: `ninja check-tidy` / `ninja tidy-fix` and
# scripts/ci/check_tidy.sh pass no -checks. Full write-up: site/articles/coding-style.md.
#
# Naming (readability-identifier-naming): types and template parameters CamelCase (clang-tidy's
# name for PascalCase); functions, variables, constants and namespaces lower_case; private and
# protected non-static data members lower_case with a leading underscore; public and static
# data members lower_case; enumerators CamelCase; macros UPPER_CASE. Kinds that are not set
# fall through to the generic one (Variable, Function, …), which is what gives every
# identifier a rule. Do not set ConstantMember, Member, or any *Constant*/…Variable kind:
# they would take precedence over the access-specific member rules and the variable rule.
Checks: >-
    -*,
    readability-identifier-naming,
    modernize-avoid-bind,
    modernize-concat-nested-namespaces,
    modernize-deprecated-headers,
    modernize-deprecated-ios-base-aliases,
    modernize-make-shared,
    modernize-make-unique,
    modernize-pass-by-value,
    modernize-raw-string-literal,
    modernize-redundant-void-arg,
    modernize-replace-auto-ptr,
    modernize-replace-disallow-copy-and-assign-macro,
    modernize-replace-random-shuffle,
    modernize-shrink-to-fit,
    modernize-unary-static-assert,
    modernize-use-bool-literals,
    modernize-use-override,
# Only our own headers; never third-party/ or generated headers in the build dir
# (BuildInfo.hpp, corrosion cxxbridge). The CMake targets pass the same filter anchored at
# the checkout root.
HeaderFilterRegex: '^.*/(libsimulator|libcommon|python_bindings_jupedsim|tools)/'
CheckOptions:
    readability-identifier-naming.ClassCase: CamelCase
    readability-identifier-naming.StructCase: CamelCase
    # Rebind_TDS is the name CGAL's triangulation data structure requires in a vertex base.
    readability-identifier-naming.StructIgnoredRegexp: '^Rebind_TDS$'
    readability-identifier-naming.UnionCase: CamelCase
    readability-identifier-naming.EnumCase: CamelCase
    readability-identifier-naming.TypeAliasCase: CamelCase
    readability-identifier-naming.TypedefCase: CamelCase
    readability-identifier-naming.ConceptCase: CamelCase
    readability-identifier-naming.TemplateParameterCase: CamelCase
    readability-identifier-naming.EnumConstantCase: CamelCase
    readability-identifier-naming.FunctionCase: lower_case
    # PrintTo is the name googletest looks up (by ADL) to print a value (TestCommon.hpp).
    readability-identifier-naming.FunctionIgnoredRegexp: '^PrintTo$'
    readability-identifier-naming.MethodCase: lower_case
    readability-identifier-naming.VariableCase: lower_case
    readability-identifier-naming.ParameterCase: lower_case
    # Static data members: clang-tidy cannot apply access-dependent styles to them, so they
    # never carry the underscore prefix.
    readability-identifier-naming.ClassMemberCase: lower_case
    readability-identifier-naming.ClassConstantCase: lower_case
    readability-identifier-naming.PublicMemberCase: lower_case
    readability-identifier-naming.ProtectedMemberCase: lower_case
    readability-identifier-naming.ProtectedMemberPrefix: _
    readability-identifier-naming.PrivateMemberCase: lower_case
    readability-identifier-naming.PrivateMemberPrefix: _
    readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
    readability-identifier-naming.NamespaceCase: lower_case
    readability-identifier-naming.InlineNamespaceCase: lower_case
    # Names the standard library protocol spells in snake_case, plus cast_op_type, which
    # pybind11's type_caster protocol looks up as a dependent name (type_casters.hpp).
    readability-identifier-naming.TypeAliasIgnoredRegexp: '^(value_type|difference_type|iterator_category|pointer|reference|size_type|iterator|const_iterator|cast_op_type)$'
    readability-identifier-naming.TypedefIgnoredRegexp: '^(value_type|difference_type|iterator_category|pointer|reference|size_type|iterator|const_iterator|cast_op_type)$'
    readability-identifier-naming.IgnoreMainLikeFunctions: true
    # Rename uses of dependent members in templates too (needed by tidy-fix).
    readability-identifier-naming.AggressiveDependentMemberLookup: true
