#! /usr/bin/env bash
# SPDX-License-Identifier: LGPL-3.0-or-later
set -euo pipefail
export JPSCORE_SOURCE_PATH="@PROJECT_SOURCE_DIR@"
export PYTHONPATH="@PROJECT_SOURCE_DIR@/python_modules/jupedsim:@CMAKE_LIBRARY_OUTPUT_DIRECTORY@"

echo "Source path ${JPSCORE_SOURCE_PATH}"
echo "PYTHONPATH=${PYTHONPATH}"

exec @Python_EXECUTABLE@ @PROJECT_SOURCE_DIR@/scripts/build_site.py --source @PROJECT_SOURCE_DIR@ --out @PROJECT_BINARY_DIR@/site --version v@PROJECT_VERSION@ "$@"
