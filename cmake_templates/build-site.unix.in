#! /usr/bin/env bash
# SPDX-License-Identifier: LGPL-3.0-or-later
set -euo pipefail
export JPSCORE_SOURCE_PATH="@PROJECT_SOURCE_DIR@"
# The stage holds the package with the compiled module and its stubs; the docs
# document the native types through those stubs.
export PYTHONPATH="@PROJECT_BINARY_DIR@/stage"

echo "Source path ${JPSCORE_SOURCE_PATH}"
echo "PYTHONPATH=${PYTHONPATH}"

exec @Python_EXECUTABLE@ @PROJECT_SOURCE_DIR@/scripts/build_site.py --source @PROJECT_SOURCE_DIR@ --out @PROJECT_BINARY_DIR@/site --version v@PROJECT_VERSION@ "$@"
